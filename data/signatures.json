		{ "id": "wc-am", "label": "WooCommerce API Manager", "pattern": "class\\s+WC_AM_Client" },
		{ "id": "uplink", "label": "StellarWP Uplink", "pattern": "StellarWP\\\\Uplink\\\\" },
		{ "id": "surecart", "label": "SureCart Licensing", "pattern": "SureCart\\\\Licensing\\\\" },
		{ "id": "appsero", "label": "Appsero", "pattern": "Appsero\\\\(Client|License|Updater)\\b" },
		{ "id": "bsf-core", "label": "Brainstorm Force", "path": "bsf-core/" },
		{ "id": "tgmpa", "label": "TGM Plugin Activation", "pattern": "class\\s+TGM_Plugin_Activation\\b", "bundles": true }
